---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import { badgeVariants } from '@/components/ui/badge'
import Layout from '@/layouts/Layout.astro'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const archivePosts = await getCollection('archive')
  return archivePosts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
---

<Layout class="max-w-3xl">
  <PageHead
    slot="head"
    title={post.data.title}
    description={post.data.description}
  />

  <section class="flex flex-col gap-y-6">
    <Breadcrumbs
      items={[
        { label: 'Archive', href: '/archive', icon: 'lucide:archive' },
        { label: post.data.title, icon: 'lucide:file-text' },
      ]}
    />

    <div class="flex flex-col text-center">
      <h1
        class="mb-2 text-3xl leading-tight font-medium sm:text-4xl"
        id="post-title"
      >
        {post.data.title}
      </h1>

      <div
        class="text-muted-foreground mb-4 flex flex-col items-center justify-center divide-y divide-border text-xs sm:flex-row sm:flex-wrap sm:divide-x sm:divide-y-0 sm:text-sm"
      >
        <div class="flex w-full items-center justify-center gap-2 py-2 sm:w-fit sm:px-2 sm:py-0 first:sm:pl-0 last:sm:pr-0">
          <span>{formatDate(post.data.date)}</span>
        </div>
        {post.data.lang && (
          <div class="flex w-full items-center justify-center gap-1 py-2 sm:w-fit sm:px-2 sm:py-0 first:sm:pl-0 last:sm:pr-0">
            <Icon name="lucide:globe" class="size-3" />
            <span>{post.data.lang}</span>
          </div>
        )}
      </div>

      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap justify-center gap-2">
          {post.data.tags.map((tag) => (
            <span class={badgeVariants({ variant: 'muted' })}>
              <Icon name="lucide:hash" class="size-3" />
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <div class="rounded-lg border border-amber-500/20 bg-amber-500/5 px-4 py-3 text-sm text-amber-700 dark:text-amber-400">
      <div class="flex items-center gap-2">
        <Icon name="lucide:archive" class="size-4 shrink-0" />
        <span>This is an archived post from thewebland.net. Content may be outdated.</span>
      </div>
    </div>

    <article class="prose max-w-none">
      <Content />
    </article>
  </section>
</Layout>
